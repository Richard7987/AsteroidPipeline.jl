# Copy this file to .env (gitignored) and fill in real values.
# test/runtests.jl loads .env automatically before running the tests.

# nova.astrometry.net API key — get it from "My Profile" after signing in
# at https://nova.astrometry.net/. Enables the live plate_solve round-trip
# test; without it, that one test is skipped instead of run.
ASTROMETRY_API_KEY=

# Path to a locally-built digest2 executable (see docs/src/api/digest2.md
# for build steps). Enables the live digest2_score test; without it,
# that one test is skipped instead of run. Defaults to "digest2" (PATH
# lookup) if unset.
DIGEST2_PATH=
